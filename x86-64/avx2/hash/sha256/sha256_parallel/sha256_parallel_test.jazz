
require "sha256_parallel.jinc"
namespace sha256_parallel_16 {
    param int INPUT_LENGTH = 16;
    require "sha256_parallel_absorb_fixed.jinc"
}

export
fn sha256_parallel_test(
    reg u64 out_base
) -> reg u64 // -> ret
{
    reg u256[8] state;
    reg u64 sch_idx;
    reg u64 bits;
    reg u64 ret;

    // stack variables
    stack u256[64] schedule; // message schedule
    // stack u8[32] in0  in1  in2  in3  in4  in5  in6  in7;  // inputs
    stack u8[32] out0 out1 out2 out3 out4 out5 out6 out7; // outputs

    inline int i;

    () = #spill(out_base);

    state, schedule, sch_idx, bits = sha256_parallel::init_iv(schedule);

    // state, schedule, sch_idx, bits = sha256_parallel_16::absorb_fixed(schedule, in0, in1, in2, in3, in4, in5, in6, in7);

    schedule, out0, out1, out2, out3, out4, out5, out6, out7 = sha256_parallel::finalise(state, schedule, sch_idx, bits, out0, out1, out2, out3, out4, out5, out6, out7);

    () = #unspill(out_base);

    for i=0 to 8 { [:u32 out_base + 0*32 + 4*i] = out0[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 1*32 + 4*i] = out1[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 2*32 + 4*i] = out2[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 3*32 + 4*i] = out3[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 4*32 + 4*i] = out4[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 5*32 + 4*i] = out5[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 6*32 + 4*i] = out6[:u32 i]; }
    for i=0 to 8 { [:u32 out_base + 7*32 + 4*i] = out7[:u32 i]; }

    ret = 0;
    return ret;
}
