
param int INPUT_TEST = 16;

require "sha256_parallel.jinc"
namespace sha256_parallel_fixed {
    param int INPUT_LENGTH = INPUT_TEST;
    require "sha256_parallel_absorb_fixed.jinc"
}

export
fn sha256_parallel_test(
    reg u64 out_base
) -> reg u64 // -> ret
{
    reg u64 sch_idx;
    reg u64 bits;
    reg u64 ret;

    // stack variables
    stack u256[8] state;     // state
    stack u256[64] schedule; // message schedule
    stack u8[INPUT_TEST] in0 in1 in2 in3 in4 in5 in6 in7; // inputs
    stack u8[32] out0 out1 out2 out3 out4 out5 out6 out7; // outputs

    inline int i;

    () = #spill(out_base);

    for i=0 to INPUT_TEST {
        in0[i] = i; in1[i] = i; in2[i] = i; in3[i] = i; in4[i] = i; in5[i] = i; in6[i] = i; in7[i] = i;
    }

    sch_idx = 0; bits = 0;
    state, schedule, sch_idx, bits = sha256_parallel::init_iv(state, schedule, sch_idx, bits);

    state, schedule, sch_idx, bits = sha256_parallel_fixed::absorb_fixed(state, schedule, sch_idx, bits, in0, in1, in2, in3, in4, in5, in6, in7);

    schedule, out0, out1, out2, out3, out4, out5, out6, out7 = sha256_parallel::finalise(state, schedule, sch_idx, bits, out0, out1, out2, out3, out4, out5, out6, out7);

    () = #unspill(out_base);

    for i=0 to 32 { [:u8 out_base + 0*32 + i] = out0[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 1*32 + i] = out1[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 2*32 + i] = out2[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 3*32 + i] = out3[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 4*32 + i] = out4[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 5*32 + i] = out5[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 6*32 + i] = out6[:u8 i]; }
    for i=0 to 32 { [:u8 out_base + 7*32 + i] = out7[:u8 i]; }

    ret = 0;
    return ret;
}
