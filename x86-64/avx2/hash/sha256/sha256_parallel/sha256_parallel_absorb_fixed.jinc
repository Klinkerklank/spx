// pack one word from eight independent inputs into one large vector
inline
fn pack_word(
    reg u256 vector, // out: packed vector
    reg u64 in_idx,  // byte index within the inputs
    reg ptr u8[INPUT_LENGTH] in0 in1 in2 in3 in4 in5 in6 in7 // inputs
) reg u256 // -> vector
{
    // register variables
    reg u32 word; // temporary variable for copying purposes

    word = in0.[:u32 in_byte_idx];                vector  = (u256) word;
    word = in1.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;
    word = in2.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;
    word = in3.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;
    word = in4.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;
    word = in5.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;
    word = in6.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;
    word = in7.[:u32 in_byte_idx]; vector <<= 32; vector += (u256) word;

    return vector;
}

// pack one byte from eight independent inputs into one large vector
inline
fn pack_byte(
    reg u256 vector, // out: packed vector
    reg u64 in_idx,  // byte index within the inputs
    reg u64 vec_idx, // byte index of the input within the packed words (from the most-significant side)
    reg ptr u8[INPUT_LENGTH] in0 in1 in2 in3 in4 in5 in6 in7 // inputs
) reg u256 // -> vector
{
    // register variables
    reg u32 byte; // temporary variable for copying purposes

    vector = 0; // make sure all other bytes except for the copied ones will be zero

    byte = in0.[:u8 in_byte_idx];                vector  = (u256) byte;
    byte = in1.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;
    byte = in2.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;
    byte = in3.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;
    byte = in4.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;
    byte = in5.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;
    byte = in6.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;
    byte = in7.[:u8 in_byte_idx]; vector <<= 32; vector += (u256) byte;

    // offset all bytes to the correct index within their words
    if (vec_idx == 0) {
        vector <<= 24;
    } else if (vec_idx == 1) {
        vector <<= 16;
    } else if (vec_idx == 2) {
        vector <<= 8;
    } // else vec_idx == 3, which means the bytes are already in the correct position

    return vector;
}

// absorb eight independent (but same-length) fixed-size pointer inputs
fn absorb_fixed(
    reg u256[STATE_u32_SIZE] state,    // Intermediate Hash Values (IHVs)
    reg ptr u256[ROUNDS_NUM] schedule, // message schedule
    reg u64 sch_idx,                   // byte index of current position in message schedule
    reg u64 bits,                      // number of bits processed
    reg ptr u8[INPUT_LENGTH] in0 in1 in2 in3 in4 in5 in6 in7 // inputs
) reg u256[STATE_u32_SIZE], reg ptr u256[ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
{
    // register variables
    reg u256 vector_256;   // placeholder for assembling a 256-bit vector
    reg u256 mask;         // bitmask for constructing vectors from bytes
    reg u32 vector_32;     // placeholder for assembling a 32-bit vector
    reg u64 in_bit_nr;     // the number of bits of input
    reg u64 in_byte_nr;    // the number of bytes of input left to consume
    reg u64 in_byte_idx;   // byte index in the input pointers
    reg u64 avail_byte_nr; // the number of bits of input
    reg u64 idx_word;      // temporary variable for computing a word index in the schedule
    reg u64 idx_byte;      // temporary variable for computing a byte index within a word
    reg u64 target;        // temporary variable for computing a target byte index to compare against

    // stack variables
    stack u256[ROUNDS_NUM] schedule_st; // message schedule stack space

    () = #spill(bits, sch_idx); // not needed until the end of this function

    schedule_st = schedule;    // associate the schedule with the stack
    in_byte_idx = 0;           // (counts up to INPUT_LENGTH-1) index in the inputs of the next byte to be consumed
    in_byte_nr = INPUT_LENGTH; // (counts down to 0) at the start, INPUT_LENGTH number of bytes of input are available

    // compute how many bytes of message space are available in the schedule
    avail_byte_nr  = MSG_BLOCK_u8_SIZE;
    avail_byte_nr -= sch_idx;

    idx_word = sch_idx; idx_word /= 4; // get the word index of the next byte to be placed in the schedule
    idx_byte = sch_idx; idx_byte %= 4; // get the byte index within the word

    // if enough input is available, first top off the current schedule and compress
    if (in_byte_nr >= avail_byte_nr) {

        // if the byte index is not word-aligned, the current word must first be filled byte by byte
        if (idx_byte != 0) {

            vector_256 = schedule[idx_word]; // retrieve the current word

            while (idx_byte < 4) {

                // pack one byte from each input into one vector
                mask = pack_byte(mask, in_byte_idx, idx_byte, in0, in1, in2, in3, in4, in5, in6, in7);

                vector_256 ^= mask; // combine the vector of existing data and the vector with the new bytes

                // consumed one byte
                in_byte_idx += 1;
                idx_byte    += 1;
            }

            schedule[idx_word] = vector_256; // overwrite the vector in the schedule
            idx_word += 1; // one word has been filled and stored
        }
        
        // fill the rest of the schedule with entire words of input
        while (idx_word < MSG_BLOCK_u32_SIZE) {

            // gather one word from each input, and insert the word into the packed vector
            vector_256 = pack_word(vector_256, in_byte_idx, in0, in1, in2, in3, in4, in5, in6, in7);
            
            schedule[idx_word] = vector_256; // store the assembled vector in the schedule

            in_byte_idx += 4; // four bytes of input have been gathered
            idx_word += 1;    // one word of input has been gathered
        }

        state = compress(state, schedule); // compress the message schedule into the state

        in_byte_nr -= avail_byte_nr; // the number of bytes needed to top off the schedule have been consumed

        // if enough input is available, fill entire message schedules and compress
        while (in_byte_nr >= MSG_BLOCK_u8_SIZE) {

            // fill the (empty) schedule completely
            for i=0 to MSG_BLOCK_u32_SIZE {

                // gather one word from each input, and insert the word into the packed vector
                vector_256 = pack_word(vector_256, in_byte_idx, in0, in1, in2, in3, in4, in5, in6, in7);
                
                schedule[i] = vector_256; // store the assembled vector in the schedule

                in_byte_idx += 4; // four bytes of input have been gathered
            }

            state = compress(state, schedule); // compress the message schedule into the state
            
            in_byte_nr -= MSG_BLOCK_u8_SIZE; // one entire block of input has been consumed
        }

        // message schedule(s) were completed, so now the next message schedule is empty again
        idx_word = 0;
        idx_byte = 0;
    }

    // store the remainder of the input in the schedule (guaranteed to not complete the schedule)
    if (in_byte_nr > 0) {

        // check if enough input bytes are present to complete at least one word
        if (in_byte_nr >= 4-idx_byte) {

            // first complete the current word if it's not byte-aligned
            if (idx_byte != 0) {

                vector_256 = schedule[idx_word]; // retrieve the current word

                while (idx_byte < 4) {

                    // pack one byte from each input into one vector
                    mask = pack_byte(mask, in_byte_idx, idx_byte, in0, in1, in2, in3, in4, in5, in6, in7);

                    vector_256 ^= mask; // combine the vector of existing data and the vector with the new bytes

                    // consumed one byte
                    in_byte_nr  -= 1;
                    in_byte_idx += 1;
                    idx_byte    += 1;
                }

                schedule[idx_word] = vector_256; // overwrite the vector in the schedule

                // one word has been filled and stored
                idx_byte  = 0;
                idx_word += 1;
            }

            // write as many full words as possible
            while (in_byte_nr >= 4) {

                // gather one word from each input, and insert the word into the packed vector
                vector_256 = pack_word(vector_256, in_byte_idx, in0, in1, in2, in3, in4, in5, in6, in7);
                
                schedule[idx_word] = vector_256; // store the assembled vector in the schedule

                // four bytes have been consumed
                in_byte_nr  -= 4;
                in_byte_idx += 4;
                idx_word    += 1;
            }
        }

        // write any remaining bytes (guaranteed to not complete the word)
        if (in_byte_nr > 0) {

            vector_256 = schedule[idx_word]; // retrieve the current word
            target = idx_byte; target += in_byte_nr; // compute the target byte

            while (idx_byte < target) {

                // pack one byte from each input into one vector
                mask = pack_byte(mask, in_byte_idx, idx_byte, in0, in1, in2, in3, in4, in5, in6, in7);

                vector_256 ^= mask; // combine the vector of existing data and the vector with the new bytes

                // consumed one byte
                in_byte_idx += 1;
                idx_byte    += 1;
            }

            schedule[idx_word] = vector_256; // overwrite the vector in the schedule
        }
    }

    // update how many bits of input have been processed after consuming the entire input
    () = #unspill(bits);
    in_bit_nr = INPUT_LENGTH << 3; // INPUT_LENGTH is in number of bytes, so multiply by eight to get number of bits
    bits += in_bit_nr;

    // update schedule byte index
    () = #unspill(sch_idx);
    sch_idx += INPUT_LENGTH;
    sch_idx %= MSG_BLOCK_u8_SIZE;

    return state, schedule, sch_idx, bits;
}