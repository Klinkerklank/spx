        (8u32)[0x1f83d9ab, 0x1f83d9ab, 0x1f83d9ab, 0x1f83d9ab, 0x1f83d9ab, 0x1f83d9ab, 0x1f83d9ab, 0x1f83d9ab],
        (8u32)[0x5be0cd19, 0x5be0cd19, 0x5be0cd19, 0x5be0cd19, 0x5be0cd19, 0x5be0cd19, 0x5be0cd19, 0x5be0cd19]
    }

    // separator word
    u256 sep_word   = (8u32)[0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000];
    // length encoding
    u256 length_enc = (8u32)[0x00000080, 0x00000080, 0x00000080, 0x00000080, 0x00000080, 0x00000080, 0x00000080, 0x00000080];

    // rotate right
    inline
    fn rrot(
        reg u256 w,
        inline int i
    ) -> reg u256
    {
        reg u256 a;

        a  = w; // a = w
        a  = #VPSLL(a,32-i); // a = w << 32-i

        w  = #VPSRL(w,i); // w = w >> i

        w |= a; // w = (w >> i) || (w << 32-i)

        return w;
    }

    // choice function
    inline
    fn f_choice(
        reg u256 x,
        reg u256 y,
        reg u256 z
    ) -> reg u256
    {
        reg u256 a b;

        a  = x; // a = x
        a &= y; // a = x /\ y

        b  = x; // b = x
        b  = #NOT_256(b); // b = ¬x
        b &= z; // b = ¬x /\ z

        a ^= b; // a = (x /\ y) ^ (¬x /\ z)

        return a;
    }

    // majority function
    inline
    fn f_majority(
        reg u256 x,
        reg u256 y,
        reg u256 z
    ) -> reg u256
    {
        reg u256 a b;

        a  = x; // a = x
        a &= y; // a = x /\ y

        b  = x; // b = x
        b &= z; // b = x /\ z

        a ^= b; // a = (x /\ y) ^ (x /\ z)

        b  = y; // b = y
        b &= z; // b = y /\ z

        a ^= b; // a = (x /\ y) ^ (x /\ z) ^ (y /\ z)

        return a;
    }

    // σ0
    inline
    fn sigma0(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u;

        u   = w; // u = w
        w >>= sigma0_2; // w = w >> 3

        u   = rrot(u, sigma0_0); // u = w rrot 7
        w  ^= u; // w = (w rrot 7) ^ (w >> 3)

        u   = rrot(u, sigma0_1-sigma0_0); // u = w rrot 18
        w  ^= u; // w = (w rrot 7) ^ (w rrot 18) ^ (w >> 3)

        return w;
    }

    // σ1
    inline
    fn sigma1(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u;

        u   = w; // u = w
        w >>= sigma1_2; // w = w >> 10

        u   = rrot(u, sigma1_0); // u = w rrot 17
        w  ^= u; // w = (w rrot 17) ^ (w >> 10)

        u   = rrot(u, sigma1_1-sigma1_0); // u = w rrot 19
        w  ^= u; // w = (w rrot 17) ^ (w rrot 19) ^ (w >> 10)

        return w;
    }

    // Σ0
    inline
    fn Sigma0(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u;
        reg u256 v;

        u  = w; // u = w
        u  = rrot(u, Sigma0_0); // u = w rrot 2

        v  = w; // v = w
        v  = rrot(v, Sigma0_1); // v = w rrot 13
        u ^= v; // u = (w rrot 2) ^ (w rrot 13)

        v  = rrot(u, Sigma0_2-Sigma0_1); // v = w rrot 22
        u ^= v; // w = (w rrot 2) ^ (w rrot 13) ^ (w rrot 22)

        return u;
    }

    // Σ1
    inline
    fn Sigma1(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u;
        reg u256 v;

        u  = w; // u = w
        u  = rrot(u, Sigma1_0); // u = w rrot 6

        v  = w; // v = w
        v  = rrot(v, Sigma1_1); // v = w rrot 11
        u ^= v; // u = (w rrot 6) ^ (w rrot 11)

        v  = rrot(u, Sigma1_2-Sigma1_1); // v = w rrot 25
        u ^= v; // w = (w rrot 6) ^ (w rrot 11) ^ (w rrot 25)

        return u;
    }

    // function for computing and storing one word in the message schedule
    inline fn f_word(
        stack u256[ROUNDS_NUM] sch,
        inline int i
    )
    {
        reg u256 v w;

        w  = sch[i-15]; // w = sch[i-15]
        w  = sigma0(w); // w = σ0(sch[i-15])

        v  = sch[i-2];  // v = sch[i-2]
        v  = sigma1(v); // v = σ1(sch[i-2])

        w = #VPADD_8u32(w, v); // w = σ1(sch[i-2]) + σ0(sch[i-15])

        v  = sch[i-7];  // v = sch[i-7]
        w = #VPADD_8u32(w, v); // w = σ1(sch[i-2]) + sch[i-7] + σ0(sch[i-15])

        v  = sch[i-16]; // v = sch[i-16]
        w = #VPADD_8u32(w, v); // w = σ1(sch[i-2]) + sch[i-7] + σ0(sch[i-15]) + sch[i-16]

        sch[i] = w;
    }

    // function for computing the message schedule
    inline fn f_schedule(
        reg ptr u256[MSG_u32_SIZE] msg // messages in eight-lane vector format
    ) -> stack u256[ROUNDS_NUM] // -> sch
    {
        reg u256 word; // working variable for formatting and setting the words in the schedule

        stack u256[ROUNDS_NUM] sch; // message schedule

        inline int i;

        // absorb all messages (one word at a time)
        for i=0 to MSG_u32_SIZE {
            // set i-th word of input data
            sch[i] = msg[i];
        }

        // set the word containing the separator bit and zero-padding
        word = sep_word;
        sch[MSG_u32_SIZE] = word;

        // set more zero-padding
        word = 0x0;
        for i=MSG_u32_SIZE+1 to MSG_BLOCK_u32_SIZE-1 {
            sch[i] = word;
        }

        // set the word containing the length encoding
        // (the length encoding actually starts at sch[MSG_BLOCK_u32_SIZE-2] but SPX_N is so
        //  small that the first 32 bits of length encoding are always zero)
        word = length_enc;
        sch[MSG_BLOCK_u32_SIZE-1] = word;

        // compute the rest of the schedule using f_word
        for i=MSG_BLOCK_u32_SIZE to ROUND_NUM {
            f_word(sch, i);
        }

        return sch;
    }

    // round function
    inline
    fn f_round(
        reg u256 ta tb tc td te tf tg th, // IHV working variables
        reg ptr u256[ROUNDS_NUM] sch,     // message schedule
        inline int i
    ) -> reg u256, reg u256, reg u256, reg u256, reg u256, reg u256, reg u256, reg u256 // -> ta, tb, tc, td, te, tf, tg, th
    {
        reg u256 t1; // intermediate value t1
        reg u256 t2; // intermediate value t2
        reg u256 t;  // temporary variable

        // set initial value of t1
        t1 = th; // t1 = th

        // add relevant message schedule word
        t  = sch[i]; // t = sch[i]
        t1 = #VPADD_8u32(t1, t); // t1 = th + sch[i]

        // add relevant round constant
        t  = k[i]; // t = k[i]
        t1 = #VPADD_8u32(t1, t); // t1 = th + sch[i] + k[i]

        // add f_choice(te, tf, tg)
        t  = f_choice(te, tf, tg); // t = f_choice(te, tf, tg)
        t1 = #VPADD_8u32(t1, t); // t1 = th + sch[i] + k[i] + f_choice(te, tf, tg)

        // add Σ1(te)
        t  = Sigma1(te); // t = Σ1(te)
        t1 = #VPADD_8u32(t1, t); // t1 = th + sch[i] + k[i] + f_choice(te, tf, tg) + Σ1(te)

        // update te, tf, tg, and th
        th = tg; tg = tf; tf = te;
        te = td; te = #VPADD_8u32(te, t1); // te = td + t1

        // set initial value of t2
        t2 = t1; // t2 = t1

        // add f_majority(ta, tb, tc)
        t  = f_majority(ta, tb, tc); // t = f_majority(ta, tb, tc)
        t2 = #VPADD_8u32(t2, t); // t2 = t1 + f_majority(ta, tb, tc)

        // add Σ1(ta)
        t  = Sigma0(ta); // t = Σ0(ta)
        t2 = #VPADD_8u32(t2, t); // t2 = t1 + f_majority(ta, tb, tc) + Σ0(ta)

        // update ta, tb, tc, and td
        td = tc; tc = tb; tb = ta; ta = t2;

        return t1, tb, tc, td, te, tf, tg, th;
    }

    // main loop function
    inline
    fn f_loop(
        reg u256 ta tb tc td te tf tg th, // IHV working variables
        reg ptr u256[ROUNDS_NUM] sch      // message schedule
    ) -> reg u256, reg u256, reg u256, reg u256, reg u256, reg u256, reg u256, reg u256 // -> ta, tb, tc, td, te, tf, tg, th
    {
        reg u256 tmp; // temporary working variable

        inline int i;

        // set intermediate hash values to initialisation vectors 
        ta = iv[0]; tb = iv[1]; tc = iv[2]; td = iv[3];
        te = iv[4]; tf = iv[5]; tg = iv[6]; th = iv[7];

        // run all loop iterations, and compute and update the working variables
        for i=0 to ROUNDS_NUM {
            ta, tb, tc, td, te, tf, tg, th = f_round(ta, tb, tc, td, te, tf, tg, th, sch, i);
        }

        // finalise the intermediate hash values by adding the working variables
        tmp = iv[0]; ta = #VPADD_8u32(ta, tmp);
        tmp = iv[1]; tb = #VPADD_8u32(tb, tmp);
        tmp = iv[2]; tc = #VPADD_8u32(tc, tmp);
        tmp = iv[3]; td = #VPADD_8u32(td, tmp);
        tmp = iv[4]; te = #VPADD_8u32(te, tmp);
        tmp = iv[5]; tf = #VPADD_8u32(tf, tmp);
        tmp = iv[6]; tg = #VPADD_8u32(tg, tmp);
        tmp = iv[7]; th = #VPADD_8u32(th, tmp);

        return ta, tb, tc, td, te, tf, tg, th;
    }

    // load the data from independent pointers into eight-lane vectors
    inline
    fn load_inputs(
        reg ptr u8[SPX_N] in0 in1 in2 in3 in4 in5 in6 in7 // input pointers
    )
    {
        reg u256[MSG_u32_SIZE] vectors; // eight-lane vectors
        reg u256 vector;                // temporary variable for assembling an eight-lane vector

        inline int i;

        // absorb all messages (one word at a time)
        for i=0 to MSG_u32_SIZE {
            // take one 32-bit word from one input,
            // and left-shift to make place for the next 
            vector  = in0[:u32 i]; vector <<= 32;
            vector += in1[:u32 i]; vector <<= 32;
            vector += in2[:u32 i]; vector <<= 32;
            vector += in3[:u32 i]; vector <<= 32;
            vector += in4[:u32 i]; vector <<= 32;
            vector += in5[:u32 i]; vector <<= 32;
            vector += in6[:u32 i]; vector <<= 32;
            vector += in7[:u32 i];

            vectors[i] = vector;
        }

        return vectors;
    }

    // write the data from eight-lane vectors into the independent output pointers
    inline
    fn write_outputs(
        reg ptr u8[SPX_N] out0 out1 out2 out3 out4 out5 out6 out7, // output pointers
        reg u256          ihv0 ihv1 ihv2 ihv3 ihv4 ihv5 ihv6 ihv7  // digest vectors
    )
    {
        // write all digests (one word at a time)
        for i=0 to MSG_u32_SIZE {
            out0[:u32 i] = ihv0[:u32 i];
            out1[:u32 i] = ihv1[:u32 i];
            out2[:u32 i] = ihv2[:u32 i];
            out3[:u32 i] = ihv3[:u32 i];
            out4[:u32 i] = ihv4[:u32 i];
            out5[:u32 i] = ihv5[:u32 i];
            out6[:u32 i] = ihv6[:u32 i];
            out7[:u32 i] = ihv7[:u32 i];
        }
    }

    // main loop function
    fn sha256_parallel(
        reg ptr u8[SPX_N]  in0  in1  in2  in3  in4  in5  in6  in7, // inputs
        reg ptr u8[SPX_N] out0 out1 out2 out3 out4 out5 out6 out7  // outputs
    )
    {
        reg u256 ihv0 ihv1 ihv2 ihv3 ihv4 ihv5 ihv6 ihv7; // intermediate hash values
        reg u256[MSG_u32_SIZE] msg; // temporary array for converting the inputs to an AVX2-compatible variant

        stack u256[ROUNDS_NUM] sch; // message schedule

        // convert the independent register pointers to eight-lane vectorised inputs
        msg = load_inputs(in0, in1, in2, in3, in4, in5, in6, in7);

        // compute the message schedule
        sch = f_schedule(msg);

        // compute the digests by use of the loop function
        ihv0, ihv1, ihv2, ihv3, ihv4, ihv5, ihv6, ihv7 = f_loop(ihv0, ihv1, ihv2, ihv3, ihv4, ihv5, ihv6, ihv7, sch);

        // convert the eight-lane vectorised IHVs to the independent output pointers
        write_outputs(out0, out1, out2, out3, out4, out5, out6, out7, ihv0, ihv1, ihv2, ihv3, ihv4, ihv5, ihv6, ihv7);
    }
}