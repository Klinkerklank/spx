/* 
 * namespaces for the single-input and parallel SHA256 implementations,
 * and for the fixed-length input absortion functions
 * 
 * author: Dennis op 't Roodt 2026-09-24 (d.n.e.o.t.roodt@tue.nl)
 */

require "../../stdlib/memcpy/memcpy.jinc" // for copying SPX_N-byte strings

// already provides the namespace 'sha256' internally
require "sha256_single/sha256.jinc"

namespace sha256_n {
    param int INPUT_LENGTH = SPX_N;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_22 {
    param int INPUT_LENGTH = 22;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_2 {
    param int INPUT_LENGTH = 2;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_mgf1 {
    param int INPUT_LENGTH = 2*SPX_N + SHA256_OUT + 4;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_block {
    param int INPUT_LENGTH = SHA256_IN;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_digest {
    param int INPUT_LENGTH = SHA256_OUT;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

// already provides the namespace 'sha256_parallel' internally
require "sha256_parallel/sha256_parallel.jinc"

namespace sha256_parallel_22 {
    param int INPUT_LENGTH = 22;
    require "sha256_parallel/sha256_parallel_absorb_fixed.jinc"
}

namespace sha256_parallel_n {
    param int INPUT_LENGTH = SPX_N;
    require "sha256_parallel/sha256_parallel_absorb_fixed.jinc"
}

// code for initialising the SHA-2 state cache(s)

// compute the SHA-2 state after consuming exactly one block consisting of PK.seed and zero-padding
fn init_caches(reg ptr u8[96] sha2_state_caches, reg ptr u8[SPX_N] pkseed) -> reg ptr u8[96]
{
    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u32[SHA2_STATE_WORD_SIZE] state; // SHA2 state
    stack u32[SHA2_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA256_IN] buf;               // buffer for PK.seed and zero-padding

    inline int i;

    // construct the input block
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], pkseed); // copy PK.seed
    for i=SPX_N to SHA256_IN {                                 
        buf[i] = 0x0;                                       // set the zero padding
    }

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    state, schedule, sch_idx, bits = sha256       :: init_iv     (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha256_block :: absorb_fixed(state, schedule, sch_idx, bits, buf);

    // set the state in the cache
    for i=0 to 8 {                                 
        sha2_state_caches[:u32 i] = state[i];
    }

    return sha2_state_caches;
}