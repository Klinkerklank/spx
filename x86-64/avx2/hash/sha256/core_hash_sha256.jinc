require "sha256_avx/sha256_compress_avx.jinc"
require "sha256_avx/sha256_compress_avx2.jinc"
require "common/sha256_common.jinc"

namespace sha256_hmac_inner {
    param int PREFIXLEN = SHA256_IN + SPX_N;
    require "sha256_absorb/sha256_absorb.jinc"
}

namespace sha256_hmac_outer {
    param int INLEN = SHA256_IN + SHA256_OUT;
    require "sha256_array/sha256_array.jinc"
}



// already provides the namespace 'sha256' internally
require "sha256_single/sha256.jinc"

namespace sha256_n {
    param int INPUT_LENGTH = SPX_N;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_22 {
    param int INPUT_LENGTH = 22;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_2 {
    param int INPUT_LENGTH = 2;
    require "sha256_single/sha256_absorb_fixed.jinc"
}

namespace sha256_mgf1 {
    param int INPUT_LENGTH = 2*SPX_N + SHA256_OUT + 4;
    require "sha256_single/sha256_absorb_fixed.jinc"
}



// already provides the namespace 'sha256_parallel' internally
require "sha256_parallel/sha256_parallel.jinc"

namespace sha256_parallel_adrsc {
    param int INPUT_LENGTH = 22;
    require "sha256_parallel/sha256_parallel_absorb_fixed.jinc"
}

namespace sha256_parallel_n {
    param int INPUT_LENGTH = SPX_N;
    require "sha256_parallel/sha256_parallel_absorb_fixed.jinc"
}