/* 
 * implementation of SHA256 with an init/absorb/finalise interface
 * 
 * uses an AVX2 compression function adapted from https://github.com/strub/sha256/tree/main 
 * 
 * author: Dennis op 't Roodt 2026-09-22 (d.n.e.o.t.roodt@tue.nl)
 */

namespace sha256 {
    // SHA-256 parameters
    param int ROUNDS_NUM          = 64;
    param int MSG_BLOCK_BYTE_SIZE = 64;
    param int MSG_BLOCK_WORD_SIZE = MSG_BLOCK_BYTE_SIZE/4; // word = u32
    param int STATE_BYTE_SIZE     = 32;
    param int STATE_WORD_SIZE     = STATE_BYTE_SIZE/4; // word = u32
    param int WORDS_PER_VECTOR    = 256/32; // word = u32
    param int BYTES_PER_WORD      = 32/8; // word = u32

    // σ function constants
    param int sigma0_0 =  7;
    param int sigma0_1 = 18;
    param int sigma0_2 =  3;
    param int sigma1_0 = 17;
    param int sigma1_1 = 19;
    param int sigma1_2 = 10;

    // Σ function constants
    param int Sigma0_0 =  2;
    param int Sigma0_1 = 13;
    param int Sigma0_2 = 22;
    param int Sigma1_0 =  6;
    param int Sigma1_1 = 11;
    param int Sigma1_2 = 25;

    // round constants
    // each u256 entry has the same four u32 constants K[2i+3], K[2i+2], K[2i+1], K[2i] in both
    // 128-bit halves so that one VPADD_4u64 adds K[2i], K[2i+1], K[2i+2], K[2i+3] to both blocks
    u256[ROUNDS_NUM / 4] sha256_k = {
        (8u32)[0xe9b5dba5, 0xb5c0fbcf, 0x71374491, 0x428a2f98, 0xe9b5dba5, 0xb5c0fbcf, 0x71374491, 0x428a2f98],
        (8u32)[0xab1c5ed5, 0x923f82a4, 0x59f111f1, 0x3956c25b, 0xab1c5ed5, 0x923f82a4, 0x59f111f1, 0x3956c25b],
        (8u32)[0x550c7dc3, 0x243185be, 0x12835b01, 0xd807aa98, 0x550c7dc3, 0x243185be, 0x12835b01, 0xd807aa98],
        (8u32)[0xc19bf174, 0x9bdc06a7, 0x80deb1fe, 0x72be5d74, 0xc19bf174, 0x9bdc06a7, 0x80deb1fe, 0x72be5d74],
        (8u32)[0x240ca1cc, 0x0fc19dc6, 0xefbe4786, 0xe49b69c1, 0x240ca1cc, 0x0fc19dc6, 0xefbe4786, 0xe49b69c1],
        (8u32)[0x76f988da, 0x5cb0a9dc, 0x4a7484aa, 0x2de92c6f, 0x76f988da, 0x5cb0a9dc, 0x4a7484aa, 0x2de92c6f],
        (8u32)[0xbf597fc7, 0xb00327c8, 0xa831c66d, 0x983e5152, 0xbf597fc7, 0xb00327c8, 0xa831c66d, 0x983e5152],
        (8u32)[0x14292967, 0x06ca6351, 0xd5a79147, 0xc6e00bf3, 0x14292967, 0x06ca6351, 0xd5a79147, 0xc6e00bf3],
        (8u32)[0x53380d13, 0x4d2c6dfc, 0x2e1b2138, 0x27b70a85, 0x53380d13, 0x4d2c6dfc, 0x2e1b2138, 0x27b70a85],
        (8u32)[0x92722c85, 0x81c2c92e, 0x766a0abb, 0x650a7354, 0x92722c85, 0x81c2c92e, 0x766a0abb, 0x650a7354],
        (8u32)[0xc76c51a3, 0xc24b8b70, 0xa81a664b, 0xa2bfe8a1, 0xc76c51a3, 0xc24b8b70, 0xa81a664b, 0xa2bfe8a1],
        (8u32)[0x106aa070, 0xf40e3585, 0xd6990624, 0xd192e819, 0x106aa070, 0xf40e3585, 0xd6990624, 0xd192e819],
        (8u32)[0x34b0bcb5, 0x2748774c, 0x1e376c08, 0x19a4c116, 0x34b0bcb5, 0x2748774c, 0x1e376c08, 0x19a4c116],
        (8u32)[0x682e6ff3, 0x5b9cca4f, 0x4ed8aa4a, 0x391c0cb3, 0x682e6ff3, 0x5b9cca4f, 0x4ed8aa4a, 0x391c0cb3],
        (8u32)[0x8cc70208, 0x84c87814, 0x78a5636f, 0x748f82ee, 0x8cc70208, 0x84c87814, 0x78a5636f, 0x748f82ee],
        (8u32)[0xc67178f2, 0xbef9a3f7, 0xa4506ceb, 0x90befffa, 0xc67178f2, 0xbef9a3f7, 0xa4506ceb, 0x90befffa]
    };

    // initialisation vector for the state variables
    u256[STATE_WORD_SIZE] sha256_iv = {
        (8u32)[0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    };

    // constant used for setting registers to 0
    u256 zero_vector_256 = (8u32)[0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000, 0x00000000];

    // big-to-litte-Endian byte-swap mask for 32-bit lanes, duplicated across
    // both 128-bit halves so a single VPSHUFB_256 fixes both blocks
    u256 gshufmask = (8u32)[
        0x0c0d0e0f, 0x08090a0b, 0x04050607, 0x00010203,
        0x0c0d0e0f, 0x08090a0b, 0x04050607, 0x00010203];

    // masks used in sigma1 schedule computation to handle the within-register
    // data dependency (W[t] depends on W[t-2] which is in the same xmm/ymm)
    u256 glomask = (8u32)[
        -1, -1, 0x0b0a0908, 0x03020100,
        -1, -1, 0x0b0a0908, 0x03020100];
    u256 ghimask = (8u32)[
        0x0b0a0908, 0x03020100, -1, -1,
        0x0b0a0908, 0x03020100, -1, -1];

    // choice function
    inline
    fn choice(
        reg u32 x,
        reg u32 y,
        reg u32 z
    ) -> reg u32
    {
        reg u32 a b;

        a  = x; // a = x
        a &= y; // a = x /\ y

        b  = !x; // b = ¬x
        b &= z;  // b = ¬x /\ z

        a ^= b; // a = (x /\ y) ^ (¬x /\ z)

        return a;
    }

    // majority function
    inline
    fn majority(
        reg u32 x,
        reg u32 y,
        reg u32 z
    ) -> reg u32
    {
        reg u32 a b;

        a  = x; // a = x
        a &= y; // a = x /\ y

        b  = x; // b = x
        b &= z; // b = x /\ z

        a ^= b; // a = (x /\ y) ^ (x /\ z)

        b  = y; // b = y
        b &= z; // b = y /\ z

        a ^= b; // a = (x /\ y) ^ (x /\ z) ^ (y /\ z)

        return a;
    }

    // σ0
    inline
    fn sigma0(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u;

        u   = w; // u = w
        w   = #VPSRL_8u32(w, sigma0_2); // w = w >> 3

        u   = rotate(u, sigma0_0); // u = w rotate 7
        w  ^= u; // w = (w rotate 7) ^ (w >> 3)

        u   = rotate(u, sigma0_1-sigma0_0); // u = w rotate 18
        w  ^= u; // w = (w rotate 7) ^ (w rotate 18) ^ (w >> 3)

        return w;
    }

    // σ1
    inline
    fn sigma1(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u;

        u   = w; // u = w

        w   = #VPSRL_8u32(w, sigma1_2); // w = w >> 10

        u   = rotate(u, sigma1_0); // u = w rotate 17
        w  ^= u; // w = (w rotate 17) ^ (w >> 10)

        u   = rotate(u, sigma1_1-sigma1_0); // u = w rotate 19
        w  ^= u; // w = (w rotate 17) ^ (w rotate 19) ^ (w >> 10)

        return w;
    }

    // Σ0
    inline
    fn Sigma0(
        reg u32 w
    ) -> reg u32
    {
        reg u32 u v;

        u    = w;                 // u = w
        u >>r= Sigma0_0;          // u = w rotate 2

        v    = w;                 // v = w
        v >>r= Sigma0_1;          // v = w rotate 13
        u   ^= v;                 // u = (w rotate 2) ^ (w rotate 13)

        v >>r= Sigma0_2-Sigma0_1; // v = w rotate 22
        u   ^= v;                 // w = (w rotate 2) ^ (w rotate 13) ^ (w rotate 22)

        return u;
    }

    // Σ1
    inline
    fn Sigma1(
        reg u256 w
    ) -> reg u256
    {
        reg u256 u v;

        u    = w;                 // u = w
        u >>r= Sigma1_0;          // u = w rotate 6

        v    = w;                 // v = w
        v >>r= Sigma1_1;          // v = w rotate 11
        u   ^= v;                 // u = (w rotate 6) ^ (w rotate 11)

        v >>r= Sigma1_2-Sigma1_1; // v = w rotate 25
        u   ^= v;                 // w = (w rotate 6) ^ (w rotate 11) ^ (w rotate 25)

        return u;
    }

    /********** FUNCTIONS INTENDED FOR EXTERNAL USE **********/

    // initialise the vectorised SHA256 state from scratch
    fn init_iv(
        reg ptr u32[STATE_WORD_SIZE] state, // pointer to the state
        reg ptr u32[ROUNDS_NUM] schedule,   // message schedule
        reg u64 sch_idx,                    // byte index of current position in message schedule
        reg u64 bits                        // number of bits processed
    ) -> reg ptr u32[STATE_WORD_SIZE], reg ptr u32[ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
    {
        // register variables
        reg u256 copy; // temporary variable for copying purposes

        inline int i;

        // set the IHVs to the initialisation vectors
        for i=0 to STATE_WORD_SIZE/WORDS_PER_VECTOR {
            copy = sha256_iv[i]; state[:u256 i] = copy;
        }

        // reset the message part of the schedule
        // (the computed part will be overwritten by compute_word anyway)
        copy = zero_vector_256;
        for i=0 to MSG_BLOCK_WORD_SIZE/WORDS_PER_VECTOR {
            schedule[:u256 i] = copy;
        }

        sch_idx = 0;
        bits = 0;

        return state, schedule, sch_idx, bits;
    }

    // initialise the vectorised SHA256 state from a cached state
    fn init_cache(
        reg ptr u32[STATE_WORD_SIZE] state,      // pointer to the state
        reg ptr u32[ROUNDS_NUM] schedule,        // message schedule
        reg u64 sch_idx,                         // byte index of current position in message schedule
        reg u64 bits,                            // number of bits processed
        reg ptr u32[STATE_WORD_SIZE] state_cache // cached Intermediate Hash Values (IHVs)
    ) -> reg ptr u32[STATE_WORD_SIZE], reg ptr u32[ROUNDS_NUM], reg u64, reg u64 // -> state, schedule, sch_idx, bits
    {
        // register variables
        reg u256 copy; // temporary variable for copying purposes

        inline int i;

        // set the IHVs to the initialisation vectors
        for i=0 to STATE_WORD_SIZE/WORDS_PER_VECTOR {
            copy = sha256_iv[:u256 i]; state[:u256 i] = copy;
        }

        // reset the message part of the schedule
        // (the computed part will be overwritten by compute_word anyway)
        copy = zero_vector_256;
        for i=0 to MSG_BLOCK_WORD_SIZE/WORDS_PER_VECTOR {
            schedule[:u256 i] = copy;
        }

        sch_idx = 0;

        return state, schedule, sch_idx, bits;
    }

    // finalise the SHA256 computation,
    // i.e. add zero padding, add the length encoding, and run the final compression(s)
    fn finalise(
        reg ptr u256[STATE_WORD_SIZE] state, // pointer to the state
        reg ptr u256[ROUNDS_NUM] schedule,   // message schedule
        reg u64 sch_idx,                     // byte index of the current position in message schedule
        reg u64 bits,                        // number of bits processed
        reg ptr u8[STATE_BYTE_SIZE] out0 out1 out2 out3 out4 out5 out6 out7 // outputs
    ) -> reg ptr u256[ROUNDS_NUM], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE], reg ptr u8[STATE_BYTE_SIZE] // -> schedule, out0, out1, out2, out3, out4, out5, out6, out7 // schedule is only returned because it needs to be writable
    {
        
    }
}