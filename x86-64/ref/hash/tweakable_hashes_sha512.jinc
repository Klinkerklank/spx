 * 
 * author: Dennis op 't Roodt 2026-09-28 (d.n.e.o.t.roodt@tue.nl)
 */

require "sha512/namespaces_sha512.jinc"
require "../adrs/adrs.jinc" // ADRS data structure
require "../stdlib/memcpy/memcpy.jinc" // for copying SPX_N-byte strings

// H_msg(R, PK.seed, PK.root, M) = MGF1-SHA-512(R || PK.seed || SHA-512(R || PK.seed || PK.root || M), m)
fn H_msg(
    reg ptr u8[SPX_M] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] r,      // message randomiser
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] pkroot, // PK.root
    reg u64 ctx_ptr,          // context pointer
    reg u64 ctx_len,          // context length
    reg u64 msg_ptr,          // message pointer
    reg u64 msg_len           // message length
) -> reg ptr u8[SPX_M] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u64[SHA512_STATE_WORD_SIZE] state; // SHA2 state
    reg ptr u8[SHA512_OUT] digest;           // buffer for the output
    stack u64[SHA512_ROUNDS_NUM] schedule;   // message schedule
    stack u8[2*SPX_N + SHA512_OUT + 4] seed; // buffer for the seed concatenated with a 4-byte counter
    stack u8[((SPX_M + SHA512_OUT - 1) / SHA512_OUT) * SHA512_OUT] concat; // concatenated hash outputs
    stack u8[2] sep; // separator between the prefix and the context (and message): zero-byte and context length

    inline int i;
    inline int hash_nr;
    
    // prepare the known parts of the seed buffer
    seed[0 : SPX_N]     = __copy_nbytes(seed[0 : SPX_N], r);          // copy R into the buffer
    seed[SPX_N : SPX_N] = __copy_nbytes(seed[SPX_N : SPX_N], pkseed); // copy PK.seed into the buffer
    seed.[:u32 2*SPX_N + SHA512_OUT] = 0; // set the counter to 0

    // prepare the context separator
    sep[0] = 0x0; sep[1] = (8u) ctx_len;
    
    () = #spill(msg_ptr); // resolves 'conflicting variables ctx_ptr and msg_ptr'
    () = #spill(msg_len); // resolves 'conflicting variables ctx_len and msg_len'
    () = #spill(pkseed);  // resolves 'conflicting variables r and pkseed'
    () = #spill(pkroot);  // resolves 'conflicting variables r and pkroot'

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute the inner hash value = sha512(R || PK.seed || PK.root || 0x00 || ctx_len || M) and write it into the seed buffer
    state, schedule, sch_idx, bits = sha512   :: init_iv        (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha512_n :: absorb_fixed   (state, schedule, sch_idx, bits, r);
    () = #unspill(pkseed);
    state, schedule, sch_idx, bits = sha512_n :: absorb_fixed   (state, schedule, sch_idx, bits, pkseed);
    () = #unspill(pkroot);
    state, schedule, sch_idx, bits = sha512_n :: absorb_fixed   (state, schedule, sch_idx, bits, pkroot);
    state, schedule, sch_idx, bits = sha512_2 :: absorb_fixed   (state, schedule, sch_idx, bits, sep);
    state, schedule, sch_idx, bits = sha512   :: absorb_variable(state, schedule, sch_idx, bits, ctx_ptr, ctx_len);
    () = #unspill(msg_ptr, msg_len);
    state, schedule, sch_idx, bits = sha512   :: absorb_variable(state, schedule, sch_idx, bits, msg_ptr, msg_len);
    digest = seed[2*SPX_N : SHA512_OUT];
    schedule, digest               = sha512   :: finalise       (state, schedule, sch_idx, bits, digest);
    seed[2*SPX_N : SHA512_OUT] = digest;
    
    // need ceil(SPX_M / SHA512_OUT) hashes of SHA512_OUT bytes each, to surpass at least SPX_M bytes
    for hash_nr=0 to (SPX_M + SHA512_OUT - 1) / SHA512_OUT {
        // set only the last byte of 'seed' to the hash iteration counter
        // (for all approved parameter sets, we will never need > 255 hash output concatenations)
        seed[2*SPX_N + SHA512_OUT + 3] = (8u) hash_nr;

        // initialise the sch_idx and bits variables
        sch_idx = 0; bits = 0;
        
        // compute sha512(seed), where seed includes the counter
        state, schedule, sch_idx, bits = sha512      :: init_iv        (state, schedule, sch_idx, bits);
        state, schedule, sch_idx, bits = sha512_mgf1 :: absorb_fixed   (state, schedule, sch_idx, bits, seed);
        digest = concat[hash_nr*SHA512_OUT : SHA512_OUT];
        schedule, digest               = sha512      :: finalise       (state, schedule, sch_idx, bits, digest);
        concat[hash_nr*SHA512_OUT : SHA512_OUT] = digest;
    }

    () = #unspill(out);
    
    // truncate the concatenated hash outputs to the correct length by copying only the first SPX_M bytes
    for i=0 to SPX_M { out[i] = concat[i]; }
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_msg(
    reg ptr u8[SPX_M] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] r,      // message randomiser
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] pkroot, // PK.root
    reg u64 ctx_ptr,          // context pointer
    reg u64 ctx_len,          // context length
    reg u64 msg_ptr,          // message pointer
    reg u64 msg_len           // message length
) -> reg ptr u8[SPX_M] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; r = r; pkseed = pkseed; pkroot = pkroot; ctx_ptr = ctx_ptr; ctx_len = ctx_len; msg_ptr = msg_ptr; msg_len = msg_len;

    out = H_msg(out, r, pkseed, pkroot, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// PRF_msg(SK.prf, optrand, M) = Trunc_n(HMAC-SHA-512(SK.prf, optrand || M))
fn PRF_msg(
    reg ptr u8[SPX_N] out,     // output: buffer the result gets written to
    reg ptr u8[SPX_N] skprf,   // SK.prf
    reg ptr u8[SPX_N] optrand, // (optional) additional randomness
    reg u64 ctx_ptr,           // context pointer
    reg u64 ctx_len,           // context length
    reg u64 msg_ptr,           // message pointer
    reg u64 msg_len            // message length
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed
    reg u64 xor;     // temporary variable for computing XORs

    // stack variables
    stack u8[SHA512_OUT] inner;              // buffer for the inner hash digest
    stack u64[SHA512_STATE_WORD_SIZE] state; // SHA2 state
    stack u64[SHA512_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA512_IN] buf;                 // buffer for internal hash output
    stack u8[SHA512_OUT] hmac;               // buffer for HMAC output
    stack u8[2] sep; // separator between the prefix and the context (and message): zero-byte and context length

    inline int i;

    // set key = SK.prf || 00..0
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], skprf); // first part of the key is SK.prf
    for i=SPX_N to SHA512_IN { buf[i] = 0x0; }             // pad the rest of the key with zeroes

    // compute buf = (key XOR ipad) eight bytes at a time
    // reading a u64 word of a byte array incurs an Endianness byteswap,
    // but we also write a u64 word to a byte array which undoes the byteswap
    for i=0 to SHA512_IN/8 {
        xor  = 0x3636363636363636; // set ipad
        xor ^= buf[:u64 i];        // compute key ^ ipad
        buf[:u64 i] = xor;
    }

    // prepare the context separator
    sep[0] = 0x0; sep[1] = (8u) ctx_len;
    
    () = #spill(msg_ptr); // resolves 'conflicting variables ctx_ptr and msg_ptr'
    () = #spill(msg_len); // resolves 'conflicting variables ctx_len and msg_len'

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute inner = sha512((key xor ipad) || optrand || M)
    state, schedule, sch_idx, bits = sha512       :: init_iv        (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha512_block :: absorb_fixed   (state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha512_n     :: absorb_fixed   (state, schedule, sch_idx, bits, optrand);
    state, schedule, sch_idx, bits = sha512_2     :: absorb_fixed   (state, schedule, sch_idx, bits, sep);
    state, schedule, sch_idx, bits = sha512       :: absorb_variable(state, schedule, sch_idx, bits, ctx_ptr, ctx_len);
    () = #unspill(msg_ptr, msg_len);
    state, schedule, sch_idx, bits = sha512       :: absorb_variable(state, schedule, sch_idx, bits, msg_ptr, msg_len);
    schedule, inner                = sha512       :: finalise       (state, schedule, sch_idx, bits, inner);

    // compute buf = (key XOR opad) eight bytes at a time
    // reading a u64 word of a byte array incurs an Endianness byteswap,
    // but we also write a u64 word to a byte array which undoes the byteswap
    for i=0 to SHA512_IN/8 {
        // bitwise xor (ipad ^ opad) with buf, as
        // buf = (key xor ipad), so
        // buf xor (ipad ^ opad) = (key xor ipad) xor (ipad ^ opad) = key ^ opad
        xor  = 0x6A6A6A6A6A6A6A6A; // set (ipad ^ opad)
        xor ^= buf[:u64 i];        // compute key ^ opad
        buf[:u64 i] = xor;
    }

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute hmac = sha512((key xor opad) || inner)
    state, schedule, sch_idx, bits = sha512        :: init_iv        (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha512_block  :: absorb_fixed   (state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha512_digest :: absorb_fixed   (state, schedule, sch_idx, bits, inner);
    schedule, hmac                 = sha512        :: finalise       (state, schedule, sch_idx, bits, hmac);

    () = #unspill(out);

    // truncate hmac to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, hmac[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __PRF_msg(
    reg ptr u8[SPX_N] out,     // output: buffer the result gets written to
    reg ptr u8[SPX_N] skprf,   // SK.prf
    reg ptr u8[SPX_N] optrand, // (optional) additional randomness
    reg u64 ctx_ptr,           // context pointer
    reg u64 ctx_len,           // context length
    reg u64 msg_ptr,           // message pointer
    reg u64 msg_len            // message length
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; skprf = skprf; optrand = optrand; ctx_ptr = ctx_ptr; ctx_len = ctx_len; msg_ptr = msg_ptr; msg_len = msg_len;

    out = PRF_msg(out, skprf, optrand, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// PRF(PK.seed, SK.seed, ADRS) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || SK.seed))
fn PRF(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u32[SHA256_STATE_WORD_SIZE] state; // SHA-2 state
    stack u8[22] adrsc;                      // buffer for ADRS^c
    stack u8[SHA256_OUT] digest;             // buffer for the output
    stack u32[SHA256_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA256_IN] buf;                 // buffer for internal hash output

    inline int i;

    // compute the first block of input consisting of PK.seed || zero-padding
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], pkseed);
    for i=SPX_N to SHA256_IN {
        buf[i] = 0x0;
    }

    // adrsc = ADRS^c
    adrsc = __adrs_compress(adrsc, adrs);

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute digest = sha256(PK.seed || zero-padding || ADRS^c || SK.seed)
    state, schedule, sch_idx, bits = sha256       :: init_iv     (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha256_block :: absorb_fixed(state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha256_22    :: absorb_fixed(state, schedule, sch_idx, bits, adrsc);
    state, schedule, sch_idx, bits = sha256_n     :: absorb_fixed(state, schedule, sch_idx, bits, skseed);
    schedule, digest               = sha256       :: finalise    (state, schedule, sch_idx, bits, digest);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __PRF(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; skseed = skseed; adrs = adrs;

    out = PRF(out, pkseed, skseed, adrs);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// F(PK.seed, ADRS, M_1) = Trunc_n(SHA-256(PK.seed || toByte(0,64-n) || ADRS^c || M_1))
fn F(
    reg ptr u8[SPX_N] out,    // both input and output (F is in-place)
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u32[SHA256_STATE_WORD_SIZE] state; // SHA-2 state
    stack u8[22] adrsc;                      // buffer for ADRS^c
    stack u8[SHA256_OUT] digest;             // buffer for the output
    stack u32[SHA256_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA256_IN] buf;                 // buffer for internal hash output

    inline int i;

    // compute the first block of input consisting of PK.seed || zero-padding
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], pkseed);
    for i=SPX_N to SHA256_IN {
        buf[i] = 0x0;
    }

    // adrsc = ADRS^c
    adrsc = __adrs_compress(adrsc, adrs);

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute digest = digest = sha256(PK.seed || zero-padding || ADRS^c || M_1)
    state, schedule, sch_idx, bits = sha256       :: init_iv     (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha256_block :: absorb_fixed(state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha256_22    :: absorb_fixed(state, schedule, sch_idx, bits, adrsc);
    state, schedule, sch_idx, bits = sha256_n     :: absorb_fixed(state, schedule, sch_idx, bits, out);
    schedule, digest               = sha256       :: finalise    (state, schedule, sch_idx, bits, digest);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __F(
    reg ptr u8[SPX_N] out,    // both input and output (F is in-place)
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs;

    out = F(out, pkseed, adrs);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// H(PK.seed, ADRS, M_2) = Trunc_n(SHA-512(PK.seed || toByte(0,128-n) || ADRS^c || M_2))
fn H(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[SPX_N] in1,    // first part of the concatenation
    reg ptr u8[SPX_N] in2     // second part of the concatenation
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u64[SHA512_STATE_WORD_SIZE] state; // SHA-2 state
    stack u8[22] adrsc;                      // buffer for ADRS^c
    stack u8[SHA512_OUT] digest;             // buffer for the output
    stack u64[SHA512_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA512_IN] buf;                 // buffer for internal hash output

    inline int i;
    
    () = #spill(in2); // resolves 'conflicting variables in1 and in2'

    // compute the first block of input consisting of PK.seed || zero-padding
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], pkseed);
    for i=SPX_N to SHA512_IN {
        buf[i] = 0x0;
    }

    // adrsc = ADRS^c
    adrsc = __adrs_compress(adrsc, adrs);

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute digest = sha512(PK.seed || zero-padding || ADRS^c || M_2)
    state, schedule, sch_idx, bits = sha512       :: init_iv     (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha512_block :: absorb_fixed(state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha512_22    :: absorb_fixed(state, schedule, sch_idx, bits, adrsc);
    state, schedule, sch_idx, bits = sha512_n     :: absorb_fixed(state, schedule, sch_idx, bits, in1);
    () = #unspill(in2);
    state, schedule, sch_idx, bits = sha512_n     :: absorb_fixed(state, schedule, sch_idx, bits, in2);
    schedule, digest               = sha512       :: finalise    (state, schedule, sch_idx, bits, digest);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[SPX_N] in1,    // first part of the concatenation
    reg ptr u8[SPX_N] in2     // second part of the concatenation
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs; in1 = in1; in2 = in2;

    out = H(out, pkseed, adrs, in1, in2);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// T_len(PK.seed, ADRS, M_len) = Trunc_n(SHA-512(PK.seed || toByte(0,128-n) || ADRS^c || M_len))
fn T_len(
    reg ptr u8[SPX_N] out,           // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,        // PK.seed
    reg ptr u32[8] adrs,             // ADRS
    reg ptr u8[SPX_LEN*SPX_N] chains // concatenation of all chain end values in a WOTS instance
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u64[SHA512_STATE_WORD_SIZE] state; // SHA-2 state
    stack u8[22] adrsc;                      // buffer for ADRS^c
    stack u8[SHA512_OUT] digest;             // buffer for the output
    stack u64[SHA512_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA512_IN] buf;                 // buffer for internal hash output

    inline int i;

    // compute the first block of input consisting of PK.seed || zero-padding
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], pkseed);
    for i=SPX_N to SHA512_IN {
        buf[i] = 0x0;
    }

    // adrsc = ADRS^c
    adrsc = __adrs_compress(adrsc, adrs);

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute digest = sha512(PK.seed || zero-padding || ADRS^c || M_len)
    state, schedule, sch_idx, bits = sha512       :: init_iv     (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha512_block :: absorb_fixed(state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha512_22    :: absorb_fixed(state, schedule, sch_idx, bits, adrsc);
    for i=0 to SPX_LEN { // absorb all chain values
    state, schedule, sch_idx, bits = sha512_n     :: absorb_fixed(state, schedule, sch_idx, bits, chains[i*SPX_N : SPX_N]);
    }
    schedule, digest               = sha512       :: finalise    (state, schedule, sch_idx, bits, digest);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_len(
    reg ptr u8[SPX_N] out,           // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,        // PK.seed
    reg ptr u32[8] adrs,             // ADRS
    reg ptr u8[SPX_LEN*SPX_N] chains // concatenation of all chain end values in a WOTS instance
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs; chains = chains;

    out = T_len(out, pkseed, adrs, chains);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// T_k(PK.seed, ADRS, M_k) = Trunc_n(SHA-512(PK.seed || toByte(0,128-n) || ADRS^c || M_k))
fn T_k(
    reg ptr u8[SPX_N] out,        // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,     // PK.seed
    reg ptr u32[8] adrs,          // ADRS
    reg ptr u8[SPX_K*SPX_N] roots // concatenation of all roots in a FORS forest
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // not needed until the end of the function

    // register variables
    reg u64 sch_idx; // schedule index
    reg u64 bits;    // number of bits consumed

    // stack variables
    stack u64[SHA512_STATE_WORD_SIZE] state; // SHA-2 state
    stack u8[22] adrsc;                      // buffer for ADRS^c
    stack u8[SHA512_OUT] digest;             // buffer for the output
    stack u64[SHA512_ROUNDS_NUM] schedule;   // message schedule
    stack u8[SHA512_IN] buf;                 // buffer for internal hash output

    inline int i;

    // compute the first block of input consisting of PK.seed || zero-padding
    buf[0 : SPX_N] = __copy_nbytes(buf[0 : SPX_N], pkseed);
    for i=SPX_N to SHA512_IN {
        buf[i] = 0x0;
    }

    // adrsc = ADRS^c
    adrsc = __adrs_compress(adrsc, adrs);

    // initialise the sch_idx and bits variables
    sch_idx = 0; bits = 0;

    // compute digest = sha512(PK.seed || zero-padding || ADRS^c || M_k)
    state, schedule, sch_idx, bits = sha512       :: init_iv     (state, schedule, sch_idx, bits);
    state, schedule, sch_idx, bits = sha512_block :: absorb_fixed(state, schedule, sch_idx, bits, buf);
    state, schedule, sch_idx, bits = sha512_22    :: absorb_fixed(state, schedule, sch_idx, bits, adrsc);
    for i=0 to SPX_K { // absorb all FORS root values
    state, schedule, sch_idx, bits = sha512_n     :: absorb_fixed(state, schedule, sch_idx, bits, roots[i*SPX_N : SPX_N]);
    }
    schedule, digest               = sha512       :: finalise    (state, schedule, sch_idx, bits, digest);

    () = #unspill(out);

    // truncate the digest to the correct length by copying only the first SPX_N bytes
    out = __copy_nbytes(out, digest[0 : SPX_N]);
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_k(
    reg ptr u8[SPX_N] out,        // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,     // PK.seed
    reg ptr u32[8] adrs,          // ADRS
    reg ptr u8[SPX_K*SPX_N] roots // concatenation of all roots in a FORS forest
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs; roots = roots;

    out = T_k(out, pkseed, adrs, roots);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}