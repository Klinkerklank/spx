require "../adrs/adrs.jinc" // ADRS data structure
require "../stdlib/memcpy/memcpy.jinc"

// import the formosa-keccak SHAKE256 implementation
from Keccak require "common/keccak1600_generic.jinc"
from Keccak require "ref/select_bmi1.jinc"
from Keccak require "ref/keccak1600.jinc"
// from Keccak require "ref/keccak1600_updstate.jinc"

// for single bytes
namespace A_1 {
    param int _ASIZE = 1;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// for separation byte and context length
namespace A_2 {
    param int _ASIZE = 2;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// for ADRS
namespace A_32 {
    param int _ASIZE = 32;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// for PK and SK elements, M_1, and output size of PRF, PRF_msg, F, H, T_len, and T_k
namespace A_N {
    param int _ASIZE = SPX_N;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// for output size of H_msg
namespace A_M {
    param int _ASIZE = SPX_M;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// for M_len
namespace A_LENN {
    param int _ASIZE = SPX_LEN*SPX_N;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// for M_k
namespace A_KN {
    param int _ASIZE = SPX_K*SPX_N;
    from Keccak require "ref/keccak1600_fixedsizes_ASIZE.jinc"
}

// H_msg(R, PK.seed, PK.root, M) = SHAKE256(R || PK.seed || PK.root || M, 8*SPX_M)
fn H_msg(
    reg ptr u8[SPX_M] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] r,      // message randomiser
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] pkroot, // PK.root
    reg u64 ctx_ptr,          // context pointer
    reg u64 ctx_len,          // context length
    reg u64 msg_ptr,          // message pointer
    reg u64 msg_len           // message length
) -> reg ptr u8[SPX_M] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[2] ctx_prefix; // temporary variable for passing the separator byte and context length

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ = A_N::__absorb_ref(st, 0,       r,          UNFINISHED, R136); // absorb R
    st, _ = A_N::__absorb_ref(st, SPX_N,   pkseed,     UNFINISHED, R136); // absorb PK.seed
    st, _ = A_N::__absorb_ref(st, 2*SPX_N, pkroot,     UNFINISHED, R136); // absorb PK.root
    ctx_prefix[0] = 0x00; ctx_prefix[1] = (8u) ctx_len;
    st, _ = A_2::__absorb_ref(st, 3*SPX_N, ctx_prefix, UNFINISHED, R136); // absorb separation byte and context length
    
    () = #spill(ctx_ptr, ctx_len);

    reg u64 msg_i;
    reg u64 msg_ptr_i;
    reg u64 offset;
    stack u8[1] msg_byte;
    inline int i;

    msg_i=0;
    // offset = 3*SPX_N+2;
    offset = 0;
    msg_ptr_i = msg_ptr;
    while (msg_i < msg_len) {
        msg_byte[0] = [:u8 msg_ptr_i];

        () = #spill(msg_len, msg_ptr_i, msg_i, offset);

        st, _ = A_1::__absorb_ref(st, 0, msg_byte, UNFINISHED, R136);

        () = #unspill(msg_len, msg_ptr_i, msg_i, offset);

        msg_i += 1;
        msg_ptr_i += 1;
        // offset += 1;
    }
    
    () = #unspill(ctx_ptr, ctx_len);

    // out = shake256_m::__shake256(out, ctx_ptr, ctx_len);
    // out = shake256_m::__shake256(out, msg_ptr, msg_len);

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_M::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H_msg(
    reg ptr u8[SPX_M] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] r,      // message randomiser
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] pkroot, // PK.root
    reg u64 ctx_ptr,          // context pointer
    reg u64 ctx_len,          // context length
    reg u64 msg_ptr,          // message pointer
    reg u64 msg_len           // message length
) -> reg ptr u8[SPX_M] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; r = r; pkseed = pkseed; pkroot = pkroot; ctx_ptr = ctx_ptr; ctx_len = ctx_len; msg_ptr = msg_ptr; msg_len = msg_len;

    out = H_msg(out, r, pkseed, pkroot, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// PRF_msg(SK.prf, optrand, M) = SHAKE256(SK.prf || optrand || M, 8*SPX_N)
fn PRF_msg(
    reg ptr u8[SPX_N] out,     // output: buffer the result gets written to
    reg ptr u8[SPX_N] skprf,   // SK.prf
    reg ptr u8[SPX_N] optrand, // (optional) additional randomness
    reg u64 ctx_ptr,           // context pointer
    reg u64 ctx_len,           // context length
    reg u64 msg_ptr,           // message pointer
    reg u64 msg_len            // message length
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[2] ctx_prefix; // temporary variable for passing the separator byte and context length

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ = A_N::__absorb_ref(st, 0,         skprf,   UNFINISHED, R136); // absorb SK.prf
    st, _ = A_N::__absorb_ref(st, SPX_N,     optrand, UNFINISHED, R136); // absorb opt_rand
    ctx_prefix[0] = 0x00; ctx_prefix[1] = (8u) ctx_len;
    st, _ = A_2::__absorb_ref(st, 2*SPX_N, ctx_prefix, UNFINISHED, R136); // absorb separation byte and context length

    // out = shake256_m::__shake256(out, ctx_ptr, ctx_len);
    // out = shake256_m::__shake256(out, msg_ptr, msg_len);

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_N::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __PRF_msg(
    reg ptr u8[SPX_N] out,     // output: buffer the result gets written to
    reg ptr u8[SPX_N] skprf,   // SK.prf
    reg ptr u8[SPX_N] optrand, // (optional) additional randomness
    reg u64 ctx_ptr,           // context pointer
    reg u64 ctx_len,           // context length
    reg u64 msg_ptr,           // message pointer
    reg u64 msg_len            // message length
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; skprf = skprf; optrand = optrand; ctx_ptr = ctx_ptr; ctx_len = ctx_len; msg_ptr = msg_ptr; msg_len = msg_len;

    out = PRF_msg(out, skprf, optrand, ctx_ptr, ctx_len, msg_ptr, msg_len);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// PRF(PK.seed, SK.seed, ADRS) = SHAKE256(PK.seed || ADRS || SK.seed, 8*SPX_N)
fn PRF(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[32] adrs_bytes; // temporary variable for passing ADRS as a byte string

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ =  A_N::__absorb_ref(st, 0,        pkseed,     UNFINISHED, R136); // absorb PK.seed
    adrs_bytes = __adrs_to_bytes(adrs_bytes, adrs);
    st, _ = A_32::__absorb_ref(st, SPX_N,    adrs_bytes, UNFINISHED, R136); // absorb ADRS
    st, _ =  A_N::__absorb_ref(st, SPX_N+32, skseed,     SHAKE,      R136); // absorb SK.seed

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_N::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __PRF(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u8[SPX_N] skseed, // SK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; skseed = skseed; adrs = adrs;

    out = PRF(out, pkseed, skseed, adrs);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// F(PK.seed, ADRS, M_1) = SHAKE256(PK.seed || ADRS || M_1, 8*SPX_N)
fn F(
    reg ptr u8[SPX_N] out,    // both input and output (F is in-place)
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[32] adrs_bytes; // temporary variable for passing ADRS as a byte string

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ =  A_N::__absorb_ref(st, 0,        pkseed,     UNFINISHED, R136); // absorb PK.seed
    adrs_bytes = __adrs_to_bytes(adrs_bytes, adrs);
    st, _ = A_32::__absorb_ref(st, SPX_N,    adrs_bytes, UNFINISHED, R136); // absorb ADRS
    st, _ =  A_N::__absorb_ref(st, SPX_N+32, out,        SHAKE,      R136); // absorb M_1

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_N::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __F(
    reg ptr u8[SPX_N] out,    // both input and output (F is in-place)
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs       // ADRS
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs;

    out = F(out, pkseed, adrs);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// H(PK.seed, ADRS, M_2) = SHAKE256(PK.seed || ADRS || M_2, 8*SPX_N)
fn H(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[SPX_N] in1,    // first part of the concatenation
    reg ptr u8[SPX_N] in2     // second part of the concatenation
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[32] adrs_bytes; // temporary variable for passing ADRS as a byte string

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ =  A_N::__absorb_ref(st, 0,          pkseed,     UNFINISHED, R136); // absorb PK.seed
    adrs_bytes = __adrs_to_bytes(adrs_bytes, adrs);
    st, _ = A_32::__absorb_ref(st, SPX_N,      adrs_bytes, UNFINISHED, R136); // absorb ADRS
    st, _ =  A_N::__absorb_ref(st, SPX_N+32,   in1,        UNFINISHED, R136); // absorb M_2
    st, _ =  A_N::__absorb_ref(st, 2*SPX_N+32, in2,        SHAKE,      R136); // absorb M_2

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_N::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __H(
    reg ptr u8[SPX_N] out,    // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed, // PK.seed
    reg ptr u32[8] adrs,      // ADRS
    reg ptr u8[SPX_N] in1,    // first part of the concatenation
    reg ptr u8[SPX_N] in2     // second part of the concatenation
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs; in1 = in1; in2 = in2;

    out = H(out, pkseed, adrs, in1, in2);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// T_len(PK.seed, ADRS, M_len) = SHAKE256(PK.seed || ADRS || M_len, 8*SPX_N)
fn T_len(
    reg ptr u8[SPX_N] out,           // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,        // PK.seed
    reg ptr u32[8] adrs,             // ADRS
    reg ptr u8[SPX_LEN*SPX_N] chains // concatenation of all chain end values in a WOTS instance
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[32] adrs_bytes; // temporary variable for passing ADRS as a byte string

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ =    A_N::__absorb_ref(st, 0,        pkseed,     UNFINISHED, R136); // absorb PK.seed
    adrs_bytes = __adrs_to_bytes(adrs_bytes, adrs);
    st, _ =   A_32::__absorb_ref(st, SPX_N,    adrs_bytes, UNFINISHED, R136); // absorb ADRS
    st, _ = A_LENN::__absorb_ref(st, SPX_N+32, chains,     SHAKE,      R136); // absorb M_len

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_N::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_len(
    reg ptr u8[SPX_N] out,           // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,        // PK.seed
    reg ptr u32[8] adrs,             // ADRS
    reg ptr u8[SPX_LEN*SPX_N] chains // concatenation of all chain end values in a WOTS instance
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs; chains = chains;

    out = T_len(out, pkseed, adrs, chains);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}

// T_k(PK.seed, ADRS, M_k) = SHAKE256(PK.seed || ADRS || M_k, 8*SPX_N)
fn T_k(
    reg ptr u8[SPX_N] out,        // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,     // PK.seed
    reg ptr u32[8] adrs,          // ADRS
    reg ptr u8[SPX_K*SPX_N] roots // concatenation of all roots in a FORS forest
) -> reg ptr u8[SPX_N] // -> out
{
    () = #spill(out); // only needed at the end of the function
    
    // register variables
    reg ptr u64[25] st; // pointer to SHAKE256 state stack variable

    // stack variables
    stack u64[25] st_s; // internal state of SHAKE256
    stack u8[32] adrs_bytes; // temporary variable for passing ADRS as a byte string

    // SHAKE256 state initialisation
    st = st_s;
    st = __state_init_ref(st);
    
    // absorb all inputs
    st, _ =  A_N::__absorb_ref(st, 0,        pkseed,     UNFINISHED, R136); // absorb PK.seed
    adrs_bytes = __adrs_to_bytes(adrs_bytes, adrs);
    st, _ = A_32::__absorb_ref(st, SPX_N,    adrs_bytes, UNFINISHED, R136); // absorb ADRS
    st, _ = A_KN::__absorb_ref(st, SPX_N+32, roots,      SHAKE,      R136); // absorb M_k

    // squeeze to get the output
    () = #unspill(out);
    _, out = A_N::__squeeze_ref(st, out, R136);
    
    return out;
}

inline // inline wrapper that splits parameter live-ranges, to aid the Jasmin compiler
fn __T_k(
    reg ptr u8[SPX_N] out,        // output: buffer the result gets written to
    reg ptr u8[SPX_N] pkseed,     // PK.seed
    reg ptr u32[8] adrs,          // ADRS
    reg ptr u8[SPX_K*SPX_N] roots // concatenation of all roots in a FORS forest
) -> reg ptr u8[SPX_N] // -> out
{
    // split live-range of the input parameters into two segments
    out = out; pkseed = pkseed; adrs = adrs; roots = roots;

    out = T_k(out, pkseed, adrs, roots);

    // split live-range of the output parameters into two segments
    out = out;

    return out;
}