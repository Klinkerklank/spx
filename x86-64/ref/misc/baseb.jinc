/*-------------------------------------------------------------+
| ALGORITHM 4 FROM SLH-DSS (FIPS 205)                          |
| Computes the base 2^b representation of X.                   |
+-------------------------------------------------------------*/
inline
fn __base_b(
  reg ptr u32[OUTLEN] baseb,
  reg ptr u8[INLEN] input
) -> reg ptr u32[OUTLEN]
{
    reg u64 in = 0;
    reg u32 bits = 0;
    reg u32 total = 0;

    reg u64 digit;
    reg u32 in_byte;

    inline int out;

    // for (out = 0; out < out_len; out++) 
    for out=0 to OUTLEN {
		while (bits < LG_B) {
			total <<= 8;
			in_byte = (32u) input[in];
			total += in_byte;
			in += 1;
			bits += 8;
		}

		bits -= LG_B;
		
        digit = (64u) total;
    	_, _, _, _, _, digit = #SHR(digit, bits); // digit >>= bits;
		digit &= (B-1);

		baseb[out] = (32u) digit;
    }

    return baseb;
}